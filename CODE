higher_list = ["Lower!", "Please try going lower!"]
win_list = ["Great job! You found it!", "This was really fun!", "Whoa! How did you win?!"]

question_texts = [q for q, a in qa_pairs]
question_embeddings = model.encode(question_texts, convert_to_tensor=True)

THRESHOLD = 0.3


def get_response(user_input):
    input_embedding = model.encode(user_input, convert_to_tensor=True)
    similarities = util.cos_sim(input_embedding, question_embeddings)[0]
    best_idx = similarities.argmax().item()
    best_score = similarities[best_idx].item()

    if best_score < THRESHOLD:
        return best_score, "Sorry, I don't understand. Try asking about: What is this game? ,or simply say: What is your name? "

    return best_score, qa_pairs[best_idx][1]


class K0sh:
    def __init__(self, root):
        self.root = root
        self.root.title("Guess the number with K0sh AI!")
        self.root.geometry("600x700")
        self.root.configure(bg="#2E2E2E")
        self.root.resizable(False, False)

        # STATE
        self.is_playing = False
        self.is_inchat = True

        # OTHER VARIABLES
        self.num = 0
        self.guesses = 0
        self.attempts = 0

        tk.Label(
            root, text="Welcome to the ultimate quiz. GUESS THE NUMBER!", font=("Helvetica", 16, "bold"),
            fg="#FFFFFF", bg="#2E2E2E"
        ).pack(pady=10)

        self.chat_area = scrolledtext.ScrolledText(
            root, wrap=tk.WORD, height=20, width=50, font=("Helvetica", 11),
            bg="#3C3C3C", fg="#E0E0E0", insertbackground="white"
        )
        self.chat_area.pack(pady=10, padx=10)
        self.chat_area.insert(tk.END, "Loading K0sh...\n")
        self.chat_area.insert(tk.END, "Loaded K0sh successfully!\n")
        self.chat_area.insert(tk.END, f"\nBot: Hi! My name is K0sh! ")
        self.chat_area.insert(tk.END, f"\nBot: Today, we are going to play a game of... Guess the number! ")
        self.chat_area.insert(tk.END, f"\nBot: Feel free to ask anything you want, before we start! ")
        self.chat_area.insert(tk.END, f"\nBot: In order to start the game, send the word: INT. \n")
        self.chat_area.config(state="disabled")

        input_frame = tk.Frame(root, bg="#2E2E2E")
        input_frame.pack(pady=5)

        self.input_field = tk.Entry(
            input_frame, width=40, font=('Helvetica', 11), bg="#4A4A4A", fg="#FFFFFF",
            insertbackground="white"
        )
        self.input_field.pack(side=tk.LEFT, pady=10, padx=4)
        self.input_field.bind("<Return>", lambda event: self.send_message())

        tk.Button(
            input_frame, text="Send", command=self.send_message, font=("Helvetica", 11),
            bg="#4CAF50", fg="#FFFFFF", activebackground="#45A049"
        ).pack(side=tk.RIGHT, padx=5)

        tk.Button(
            root, text="Clear Chat", command=self.clear_chat, font=("Helvetica", 11),
            bg="#4CAF50", fg="#FFFFFF", activebackground="#45A049"
        ).pack(pady=10)

    def clear_chat(self):
        self.chat_area.config(state='normal')
        self.chat_area.delete(1.0, tk.END)
        self.chat_area.insert(tk.END, f"\nBot: Hi! My name is K0sh! ")
        self.chat_area.insert(tk.END, f"\nBot: Today, we are going to play a game of... Guess the number! ")
        self.chat_area.insert(tk.END, f"\nBot: Feel free to ask anything you want, before we start! ")
        self.chat_area.insert(tk.END,
                              f"\nBot: Right now, we are in chat mode. In order to start the game, send the word: INT. \n")
        self.chat_area.config(state='disabled')

    def send_message(self):
        plr_txt = self.input_field.get().strip()
        if not plr_txt:
            return

        self.chat_area.config(state='normal')
        self.chat_area.insert(tk.END, f"\nYou: {plr_txt}\n")

        self.process_input(plr_txt)

        self.chat_area.config(state='disabled')
        self.chat_area.see(tk.END)
        self.input_field.delete(0, tk.END)

    def process_input(self, plr_txt):
        if self.is_playing:
            self.game_handler(plr_txt)
        else:
            # Chat State
            score, response = get_response(plr_txt)
            self.chat_area.insert(tk.END, f"Match confidence: {score:.2f}\n")
            self.chat_area.insert(tk.END, f"Bot: {response}\n")

            # Game mode
            if plr_txt.upper() == "INT":
                self.num = random.randint(0, 100)
                self.guesses = 0
                self.chat_area.insert(tk.END,
                                      f"\nBot: Nice! Let's start. So, I've picked a number from 0-100. Try and guess it!\n")
                self.is_inchat = False
                self.is_playing = True
                return

    def game_handler(self, plr_txt):

        try:
            guess = int(plr_txt)

        except ValueError:
            self.chat_area.insert(tk.END, f"Bot: That is not a number! Please enter a number between 0 and 100.\n")
            return

        self.guesses += 1

        # Check bounds first
        if guess < 0 or guess > 100:
            self.chat_area.insert(tk.END, f"Bot: No! The number is between 0 and 100! (THIS COUNTS AS A GUESS)\n")
        elif guess == self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(win_list)}\n")
            self.chat_area.insert(tk.END, f"Bot: Your guesses: {self.guesses}!\n")
            self.chat_area.insert(tk.END, f"Bot: Send the word: INT if you wish to play again!\n")
            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(lower_list)}\n")
        elif guess >= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(higher_list)}\n")

    


