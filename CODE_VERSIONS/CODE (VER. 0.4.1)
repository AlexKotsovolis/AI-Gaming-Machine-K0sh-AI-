    def game_handler(self, plr_txt):
        try:
            guess = int(plr_txt)
        except ValueError:
            self.chat_area.insert(tk.END, f"Bot: That is not a number! Please enter a number between 0 and 100.\n")
            return

        self.guesses += 1
        userdata[self.name]['InGameScore'] -= 10
        self.chat_area.insert(tk.END, f"Bot: Your account points: {userdata[self.name]['InGameScore']} (10 points were taken from you, {self.name}.)\n")

        if guess < 0 or guess > 100:
            self.chat_area.insert(tk.END, f"Bot: Come on {self.name}, you know this is not an eligible (for this game mode) number! The number is between 0 and 100! (THIS COUNTS AS A GUESS)\n")
            self.chat_area.insert(tk.END,
                                  f"Bot: Your account points: {userdata[self.name]['InGameScore']} (no points were taken from you, {self.name}.)\n")
        elif guess == self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(win_list)}\n")
            userdata[self.name]["InGameScore"] += 10
            self.chat_area.insert(tk.END, f"Bot: Your guesses: {self.guesses}, Your Points: {userdata[self.name]["InGameScore"]}\n")
            self.chat_area.insert(tk.END,
                                  f"Bot: Reply with **RPS** (Rock-Paper-Scissors) or **GTN** (Guess the Number) if you wish to play again!\n")
            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(higher_list)}\n")
        elif guess >= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(lower_list)}\n")

