    def destroy(self):
        with open("userdata.json", "w") as file:
            json.dump(userdata, file, indent=4)
        self.root.destroy()

    def check_for_user(self, name):
        if name in userdata:
            self.name = name
            return True, f"Welcome back {self.name}! Dynamic system node re-established. 💾"

        elif name.isalpha():
            self.name = name

            userdata[self.name] = {"Joined": True, "InGameScore": 0}
            with open("userdata.json", "w") as file:
                json.dump(userdata, file, indent=4)

            return True, f"Welcome {self.name}, I am K0sh, it's really nice meeting you! New dynamic profile created. 💾"

        else:
            return False, "This isn't a real name. Please try again!"

    def safe_append_chat(self, message):
        self.root.after(0, self._append_chat_ui, message)

    def _append_chat_ui(self, message):
        self.chat_area.config(state='normal')
        self.chat_area.insert(tk.END, message)
        self.chat_area.config(state='disabled')
        self.chat_area.see(tk.END)


