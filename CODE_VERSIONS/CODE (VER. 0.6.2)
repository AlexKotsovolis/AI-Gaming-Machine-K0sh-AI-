    def _check_achievements(self):
        player = userdata[self.name]
        score  = player["InGameScore"]

        # ── IsBroke flag ────────────────────────────────────────────
        was_broke = player["IsBroke"]
        player["IsBroke"] = score < 0
        if player["IsBroke"] and not was_broke:
            self.safe_append_chat("\nK0sh: You are now broke. 😬\n")
            self._save_userdata()

        # ── Score milestones ────────────────────────────────────────
        if score >= 10_000:
            self._unlock("High Roller",  "High Roller")
        if score >= 100_000:
            self._unlock("Legend",       "Legend")
        if score >= 1_000_000:
            self._unlock("Millionaire",  "Millionaire")

        # ── Games played ────────────────────────────────────────────
        if player["Games"] >= 100:
            self._unlock("100 Games Played", "Veteran Gamer")

        # ── Win milestones ──────────────────────────────────────────
        if player["Wins"] >= 10:
            self._unlock("10 Wins",  "Ten Wins")
        if player["Wins"] >= 50:
            self._unlock("50 Wins",  "Fifty Wins")
        if player["Wins"] >= 100:
            self._unlock("100 Wins", "One Hundred Wins")

