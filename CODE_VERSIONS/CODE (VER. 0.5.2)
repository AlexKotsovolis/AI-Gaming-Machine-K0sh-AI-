    def clear_chat(self):
        self.chat_area.config(state='normal')
        self.chat_area.delete(1.0, tk.END)

        if self.name == "Empty":
            msg = f"\nBot: Hi user! My name is K0sh! "
        else:
            msg = f"\nBot: Hi {self.name}! My name is K0sh! "

        msg += (
            f"\nBot: Today, we are going to play a game of your choice! "
            f"\nBot: Feel free to ask anything you want, before we start! "
