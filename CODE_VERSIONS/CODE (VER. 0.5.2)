            "it": "Scusa, non capisco. Prova a chiedere: 'Cos'è questo gioco?'"
        }
        return best_score, fallbacks.get(lang, fallbacks["en"])

    response_dict = qa_pairs[best_idx]["responses"]
    return best_score, response_dict.get(lang, response_dict["en"])


