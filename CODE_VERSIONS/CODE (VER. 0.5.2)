                return

            # Semantic AI Conversation Matching
            score, response = get_response(plr_txt)
            self.safe_append_chat(f"[System Match Metric Conf: {score * 100:.1f}%]\nBot: {response}\n")

    def game_handler(self, plr_txt):
        try:
            guess = int(plr_txt)
        except ValueError:
            self.safe_append_chat(f"Bot: That is not a number! Please enter a number between 0 and 100.\n")
            return

        self.guesses += 1
        userdata[self.name]['InGameScore'] -= 1
        self.root.after(0, self.update_sidebar_profile)

        msg = f"Bot: Your account points: {userdata[self.name]['InGameScore']} (1 point was taken from you, {self.name}.)\n"

        if guess < 0 or guess > 100:
            msg += f"Bot: Come on {self.name}, you know this is not an eligible number! The number is between 0 and 100!\n"
        elif guess == self.num:
            msg += f"Bot: {random.choice(win_list)}\n"
            userdata[self.name]["InGameScore"] += 10
            msg += f"Bot: Your guesses: {self.guesses}, Your Points: {userdata[self.name]['InGameScore']}\n"
            msg += f"Bot: Reply with **RPS**, **GTN**, or **BLC** if you wish to swap modes!\n"
            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            msg += f"Bot: {random.choice(higher_list)}\n"
        elif guess >= self.num:
            msg += f"Bot: {random.choice(lower_list)}\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

