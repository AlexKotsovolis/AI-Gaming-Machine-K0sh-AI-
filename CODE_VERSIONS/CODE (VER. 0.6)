    def game_handler3(self, plr_txt):
        guess3 = plr_txt.strip().lower()

        if guess3 == "hit":
            self.player_hit()
            msg = f"\nBot: You hit and rolled a {self.inter}! Total points: {self.Black_jack_Score}.\n"

            if self.Black_jack_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            if self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"Bot: I hit as well! I rolled a {self.inter} (Total: {self.Black_jack_bot_Score}).\n"
            else:
                msg += f"Bot: I chose to stand with my current points.\n"

            if self.Black_jack_bot_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            self.safe_append_chat(msg)
            return

        elif guess3 == "stand":
            msg = f"\nBot: You decided to stay with a score of: {self.Black_jack_Score}\n"

            while self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"Bot: I hit to catch up! I rolled a {self.inter} (Total: {self.Black_jack_bot_Score}).\n"

            self.evaluate_results(prefix_msg=msg)
            return
        else:
            self.safe_append_chat(f"\nBot: Invalid move! Please type 'hit' or 'stand' to continue playing.\n")
            return

    def evaluate_results(self, prefix_msg=""):
        msg = prefix_msg + f"\nBot: Let's check our final scores! My score: --{self.Black_jack_bot_Score}-- vs Your score: --{self.Black_jack_Score}--.\n"

        if self.Black_jack_Score > self.perfect:
            msg += f"Bot: You exceeded 21 and busted! You lost 50 points. 💀\n"
            self.Black_jack_Score = 0
            self.Black_jack_bot_Score = 0
            userdata[self.name]["InGameScore"] -= 50
            self.is_playing3 = False
            self.is_inchat = True
        elif self.Black_jack_bot_Score > self.perfect:
            msg += f"Bot: I exceeded 21 and busted! You won 50 points! 🎉\n"
            self.Black_jack_Score = 0
            self.Black_jack_bot_Score = 0
            userdata[self.name]["InGameScore"] += 50
            self.is_playing3 = False
            self.is_inchat = True
        elif self.Black_jack_Score > self.Black_jack_bot_Score:
            self.Black_jack_Score = 0
            self.Black_jack_bot_Score = 0
            msg += f"Bot: {random.choice(win_list)} (+50 points)\n"
            userdata[self.name]["InGameScore"] += 50
            self.is_playing3 = False
            self.is_inchat = True
        elif self.Black_jack_bot_Score > self.Black_jack_Score:
            self.Black_jack_Score = 0
            self.Black_jack_bot_Score = 0
            msg += f"Bot: {random.choice(lose_list)} (-50 points)\n"
            userdata[self.name]["InGameScore"] -= 50
            self.is_playing3 = False
            self.is_inchat = True
        else:
            msg += f"Bot: It's a draw match! No points altered.\n"
            self.Black_jack_Score = 0
            self.Black_jack_bot_Score = 0
            self.is_playing3 = False
            self.is_inchat = True

        msg += f"Bot: Your Total Points: {userdata[self.name]['InGameScore']}\n"
        msg += f"Bot: Type 'BLC' to play again, or choose 'GTN' / 'RPS'!\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

        self.Black_jack_Score = 0
        self.Black_jack_bot_Score = 0
        self.is_playing3 = False

    def destroy(self):
        with open("userdata.json", "w") as f:
            json.dump(userdata, f, indent=4)
        self.root.destroy()

    def check_for_user(self, name):
        if name in userdata:
            self.name = name
            return True, f"Welcome back {self.name}! Dynamic system node re-established. 💾"
        elif name.isalpha():
            self.name = name
            userdata[self.name] = {"Joined": True, "InGameScore": 0}
            with open("userdata.json", "w") as file:
                json.dump(userdata, file, indent=4)
            return True, f"Welcome {self.name}, I am K0sh! New dynamic profile created. 💾"
        else:
            return False, "This isn't an alphabetical name string. Please try again!"

    def safe_append_chat(self, message, tag="bot"):
        self.skipped_anim    = False
        self.current_message = message
        self.current_index   = 0
        self.send_btn.config(state=tk.DISABLED)
        self.skip_btn.config(state=tk.NORMAL)
        self.root.after(0, self._typewriter_stream, message, 0, tag)

        with open("Chat History.txt", "a", encoding="utf-8") as f:
            f.write(message)

    def _typewriter_stream(self, message, index, tag="bot"):
        self.current_index = index
        if self.skipped_anim:
            return
        if index < len(message):
            self.chat_area.config(state="normal")
            self.chat_area.insert(tk.END, message[index], tag)
            self.chat_area.config(state="disabled")
            self.chat_area.see(tk.END)
            self.root.after(8, lambda: self._typewriter_stream(message, index + 1, tag))
        else:
            self.skip_btn.config(state=tk.DISABLED)
            self.send_btn.config(state=tk.NORMAL)
            self.input_field.config(state=tk.NORMAL)
            self.input_field.focus()

    def _typewriter_skip(self):
        self.skipped_anim = True
        remaining = self.current_message[self.current_index:]
        self.chat_area.config(state="normal")
        if remaining:
            self.chat_area.insert(tk.END, remaining, "bot")
        self.chat_area.config(state="disabled")
        self.chat_area.see(tk.END)
        self.skip_btn.config(state=tk.DISABLED)
        self.send_btn.config(state=tk.NORMAL)
        self.input_field.config(state=tk.NORMAL)
        self.input_field.focus()

    def player_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_Score += self.inter

    def bot_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_bot_Score += self.inter


