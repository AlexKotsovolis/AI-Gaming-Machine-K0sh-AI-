            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            msg += f"Bot: {random.choice(higher_list)}\n"
        elif guess >= self.num:
            msg += f"Bot: {random.choice(lower_list)}\n"

        self.safe_append_chat(msg)
