    def process_input(self, plr_txt):
        if self.name == "Empty":
            success, bot_message = self.check_for_user(plr_txt)
            self.safe_append_chat(f"K0sh: {bot_message}\n")
            self.root.after(0, self.update_sidebar_profile)
            return

        if self.is_playing:
            self.game_handler(plr_txt)
        elif self.is_playing2:
            self.game_handler2(plr_txt)
        elif self.is_playing3:
            self.game_handler3(plr_txt)
        else:
            if plr_txt.upper() == "GTN":
                self.num = random.randint(0, 100)
                self.guesses = 0
                self.safe_append_chat(
                    f"\nK0sh: Nice, {self.name}! I've picked a number from 0-100. You have 12 tries. Let's go!\n")
                self.is_inchat = False
                self.is_playing = True
                return

            if plr_txt.upper() == "RPS":
                self.choice = random.choice(choice_list)
                self.guesses = 0
                self.safe_append_chat(
                    f"\nK0sh: Alrighty {self.name}! Rock beats Scissors, Paper beats Rock, Scissors beats Paper.\n"
                    f"K0sh: Enter your move to begin!\n")
                self.is_inchat = False
                self.is_playing2 = True
                return

            if plr_txt.upper() == "BLC":
                self.is_playing3 = True
                self.Black_jack_Score = 0
                self.Black_jack_bot_Score = 0
                player_roll = random.randint(1, 6)
                bot_roll    = random.randint(1, 6)
                self.Black_jack_Score     += player_roll
                self.Black_jack_bot_Score += bot_roll
                self.safe_append_chat(
                    f"\nK0sh: Nice choice, {self.name}! Roll a 1-6 dice each turn. Get as close to 21 as possible.\n"
                    f"K0sh: 🎲 You rolled a {player_roll} (Total: {self.Black_jack_Score}).\n"
                    f"K0sh: 🎲 I rolled {bot_roll} (my total is hidden).\n"
                    f"K0sh: Type 'hit' to roll again, or 'stand' to freeze your hand!\n"
                )
                self.is_inchat = False
                return

            score, response = get_response(plr_txt)
            self.safe_append_chat(f"[Match confidence: {score * 100:.1f}%]\nK0sh: {response}\n")

            with open("Chat History.txt", "a", encoding="utf-8") as file:
                file.write(f"\nK0sh replied: {response}\n")
                if hasattr(self, 'history_area'):
                    self.history_area.config(state="normal")
                    self.history_area.insert(tk.END, f"\nK0sh answered: {response}\n")
                    self.history_area.config(state="disabled")

    def game_handler(self, plr_txt):
        try:
            guess = int(plr_txt)
        except ValueError:
            self.safe_append_chat("K0sh: That's not a number! Enter a number between 0 and 100.\n")
            return

        self.guesses += 1
        userdata[self.name]['InGameScore'] -= 1
        self.root.after(0, self.update_sidebar_profile)

        msg = f"K0sh: Points: {userdata[self.name]['InGameScore']} (-1 for this guess)\n"

        if guess < 0 or guess > 100:
            msg += f"K0sh: That's out of range! Stay between 0 and 100.\n"
        elif guess == self.num:
            userdata[self.name]["Games"] += 1
            userdata[self.name]["Wins"]  += 1
            userdata[self.name]["InGameScore"] += 10
            msg += (
                f"K0sh: {random.choice(win_list)}\n"
                f"K0sh: Guesses used: {self.guesses} | Points: {userdata[self.name]['InGameScore']} | Wins: {userdata[self.name]['Wins']}\n"
                f"K0sh: Reply with GTN, RPS, or BLC to play again!\n"
            )
            self.is_inchat = True
            self.is_playing = False
            self._save_userdata()
            self._check_achievements()
        elif self.guesses >= 12:
            userdata[self.name]["Games"]  += 1
            userdata[self.name]["Losses"] += 1
            userdata[self.name]["InGameScore"] -= 10
            msg += (
                f"K0sh: You used all 12 guesses. The number was {self.num}. -10 points.\n"
                f"K0sh: Reply with GTN, RPS, or BLC to try again!\n"
            )
            self.is_inchat = True
            self.is_playing = False
            self._save_userdata()
            self._check_achievements()
        elif guess < self.num:
            msg += f"K0sh: {random.choice(higher_list)}\n"
        else:
            msg += f"K0sh: {random.choice(lower_list)}\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

    def game_handler2(self, plr_txt):
        guess2 = plr_txt.strip().lower()
        self.choice = random.choice(choice_list)

        if guess2.isdigit():
            self.safe_append_chat(f"\nK0sh: That's a number — please type Rock, Paper, or Scissors!\n")
            return

        self.guesses += 1
        msg = ""
        valid_moves = {"rock", "paper", "scissors"}

        if guess2 not in valid_moves:
            self.safe_append_chat(f"\nK0sh: Invalid move! Type Rock, Paper, or Scissors.\n")
            return

        bot  = self.choice.lower()
        wins  = {("rock", "scissors"), ("paper", "rock"), ("scissors", "paper")}

        if guess2 == bot:
            userdata[self.name]["Games"] += 1
            userdata[self.name]["Draws"] += 1
            msg += (
                f"K0sh: I also chose {self.choice} — it's a draw!\n"
                f"K0sh: Draws: {userdata[self.name]['Draws']}\n"
                f"K0sh: Reply with GTN, RPS, or BLC for another round!\n"
            )
            self.is_playing2 = False
            self.is_inchat   = True
        elif (guess2, bot) in wins:
            userdata[self.name]["Games"] += 1
            userdata[self.name]["Wins"]  += 1
            userdata[self.name]["InGameScore"] += 20
            msg += (
                f"K0sh: I chose {self.choice}! {random.choice(win_list)}\n"
                f"K0sh: Wins: {userdata[self.name]['Wins']} | Points: {userdata[self.name]['InGameScore']}\n"
                f"K0sh: Reply with GTN, RPS, or BLC for another round!\n"
            )
            self.is_playing2 = False
            self.is_inchat   = True
        else:
            userdata[self.name]["Games"]  += 1
            userdata[self.name]["Losses"] += 1
            userdata[self.name]["InGameScore"] -= 20
            msg += (
                f"K0sh: I chose {self.choice}! {random.choice(lose_list)}\n"
                f"K0sh: Losses: {userdata[self.name]['Losses']} | Points: {userdata[self.name]['InGameScore']}\n"
                f"K0sh: Reply with GTN, RPS, or BLC for another round!\n"
            )
            self.is_playing2 = False
            self.is_inchat   = True

        self._save_userdata()
        self._check_achievements()
        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

    def game_handler3(self, plr_txt):
        guess3 = plr_txt.strip().lower()

        if guess3 == "hit":
            self.player_hit()
            msg = f"\nK0sh: You rolled a {self.inter}! Your total: {self.Black_jack_Score}.\n"

            if self.Black_jack_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            if self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"K0sh: I hit too — rolled a {self.inter} (my total: {self.Black_jack_bot_Score}).\n"
            else:
                msg += "K0sh: I chose to stand.\n"

            if self.Black_jack_bot_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            self.safe_append_chat(msg)

        elif guess3 == "stand":
            msg = f"\nK0sh: You stand at {self.Black_jack_Score}.\n"
            while self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"K0sh: I also hit (my total is hidden).\n"
            self.evaluate_results(prefix_msg=msg)

        else:
            self.safe_append_chat(f"\nK0sh: Invalid move {self.name}! Type 'hit' or 'stand'.\n")

    def evaluate_results(self, prefix_msg=""):
        msg = prefix_msg + f"\nK0sh: Final scores — Me: {self.Black_jack_bot_Score} | You: {self.Black_jack_Score}\n"

        player = userdata[self.name]
        player["Games"] += 1

        if self.Black_jack_Score > self.perfect:
            msg += "K0sh: You busted! -50 points. 💀\n"
            player["InGameScore"] -= 50
            player["Losses"] += 1
        elif self.Black_jack_bot_Score > self.perfect:
            msg += "K0sh: I busted! You win +50 points! 🎉\n"
            player["InGameScore"] += 50
            player["Wins"]  += 1
            player["BLCW"]  += 1
        elif self.Black_jack_Score > self.Black_jack_bot_Score:
            msg += f"K0sh: {random.choice(win_list)} +50 points!\n"
            player["InGameScore"] += 50
            player["Wins"]  += 1
            player["BLCW"]  += 1
        elif self.Black_jack_bot_Score > self.Black_jack_Score:
            msg += f"K0sh: {random.choice(lose_list)} -50 points.\n"
            player["InGameScore"] -= 50
            player["Losses"] += 1
        else:
            msg += "K0sh: Draw — no points changed.\n"
            player["Draws"] += 1

        msg += f"K0sh: Your total points: {player['InGameScore']}\n"
        msg += "K0sh: Type 'BLC' to play again, or choose GTN / RPS!\n"

        self.Black_jack_Score     = 0
        self.Black_jack_bot_Score = 0
        self.is_playing3 = False
        self.is_inchat   = True

        self._save_userdata()
        self._check_achievements()
        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

    def destroy(self):
        self._save_userdata()
        self.root.destroy()

    def check_for_user(self, name):
        if name in userdata:
            self.name = name
            return True, f"Welcome back, {self.name}! Dynamic system node re-established. 💾"
        elif name.isalpha():
            self.name = name
            userdata[self.name] = {
                "Joined": True, "InGameScore": 0, "IsBroke": False,
                "Games": 0, "Wins": 0, "Losses": 0, "Draws": 0,
                "Millionaire": False, "100 Games Played": False,
                "BLCW": 0, "Blackjack Master": False,
                "10 Wins": False, "50 Wins": False, "100 Wins": False,
                "High Roller": False, "Legend": False
            }
            self._save_userdata()
            return True, f"Welcome, {self.name}! New dynamic profile created. 💾"
        else:
            return False, "That doesn't look like a name — letters only, please!"

    def safe_append_chat(self, message, tag="bot"):
        if not hasattr(self, "_chat_queue"):
            self._chat_queue = []

        self._chat_queue.append((message, tag))

        with open("Chat History.txt", "a", encoding="utf-8") as f:
            f.write(message)

        if len(self._chat_queue) == 1:
            self._drain_chat_queue()

    def _drain_chat_queue(self):
        if not self._chat_queue:
            return
        message, tag = self._chat_queue[0]
        self.skipped_anim = False
        self.current_message = message
        self.current_index = 0
        self.send_btn.config(state=tk.DISABLED)
        self.skip_btn.config(state=tk.NORMAL)
        self.input_field.config(state=tk.DISABLED)
        self.root.after(0, self._typewriter_stream, message, 0, tag)

    def _typewriter_stream(self, message, index, tag="bot"):
        self.current_index = index
        if self.skipped_anim:
            self._finish_current_stream()
            return
        if index < len(message):
            self.chat_area.config(state="normal")
            self.chat_area.insert(tk.END, message[index], tag)
            self.chat_area.config(state="disabled")
            self.chat_area.see(tk.END)
            self.root.after(8, lambda: self._typewriter_stream(message, index + 1, tag))
        else:
            self._finish_current_stream()

    def _finish_current_stream(self):
        self.skip_btn.config(state=tk.DISABLED)
        self.send_btn.config(state=tk.NORMAL)
        self.input_field.config(state=tk.NORMAL)
        self.input_field.focus()

        if self._chat_queue:
            self._chat_queue.pop(0)
        if self._chat_queue:
            # something else is waiting — start it now
            self.root.after(50, self._drain_chat_queue)

    def _typewriter_skip(self):
        self.skipped_anim = True
        remaining = self.current_message[self.current_index:]
        self.chat_area.config(state="normal")
        if remaining:
            self.chat_area.insert(tk.END, remaining, "bot")
        self.chat_area.config(state="disabled")
        self.chat_area.see(tk.END)
        self._finish_current_stream()

    def player_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_Score += self.inter

    def bot_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_bot_Score += self.inter


class SplashScreen:

    BG      = "#050810"
    ACCENT  = "#00C8FF"
    ACCENT2 = "#0066CC"
    DIM     = "#1A3050"
    TEXT    = "#E8F4FD"
    MUTED   = "#4A6080"
    GREEN   = "#00E5A0"
    RED     = "#FF4455"

    BOOT_LINES = [
        ("K0SH AI  —  TERMINAL v0.6.3", "#00C8FF"),
        ("", None),
        ("[ SYSTEM BOOT SEQUENCE INITIATED ]", "#00E5A0"),
        ("  Loading neural language model  ...  OK", "#E8F4FD"),
        ("  Mounting user profile store    ...  OK", "#E8F4FD"),
        ("  Calibrating semantic encoder   ...  OK", "#E8F4FD"),
        ("  Initialising game subsystems   ...  OK", "#E8F4FD"),
        ("  Establishing secure session    ...  OK", "#E8F4FD"),
        ("", None),
        ("[ ALL SYSTEMS NOMINAL ]", "#00E5A0"),
        ("", None),
        ("  PRESS ANY KEY OR WAIT …", "#4A6080"),
    ]

    def __init__(self, on_done):
        self.on_done  = on_done      # callback — called when splash ends
        self._running = True
        self._bar_pct = 0.0          # 0.0 → 1.0
        self._pulse   = 0            # avatar glow frame counter
        self._line_idx = 0           # next boot line to reveal
        self._after_ids = []

        # ── window ──────────────────────────────────────────────────
        self.root = tk.Tk()
        self.root.title("K0sh AI")
        self.root.attributes("-fullscreen", True)
        self.root.attributes("-topmost", True)
        self.root.configure(bg=self.BG)
        self.root.bind("<Key>",        lambda e: self._finish())
        self.root.bind("<Button-1>",   lambda e: self._finish())
        self.root.bind("<Escape>",     lambda e: self._finish())

        W = self.root.winfo_screenwidth()
        H = self.root.winfo_screenheight()
        self.W, self.H = W, H

        # ── main canvas (everything drawn here) ─────────────────────
        self.canvas = tk.Canvas(self.root, width=W, height=H,
                                bg=self.BG, highlightthickness=0)
        self.canvas.pack(fill=tk.BOTH, expand=True)

        # static grid lines (subtle futuristic grid)
        for x in range(0, W, 60):
            self.canvas.create_line(x, 0, x, H, fill="#0A1428", width=1)
        for y in range(0, H, 60):
            self.canvas.create_line(0, y, W, y, fill="#0A1428", width=1)

        # corner brackets
        bw, bh = 60, 40
        for cx, cy, dx, dy in [(20,20,1,1),(W-20,20,-1,1),(20,H-20,1,-1),(W-20,H-20,-1,-1)]:
            self.canvas.create_line(cx, cy, cx+dx*bw, cy, fill=self.ACCENT, width=2)
            self.canvas.create_line(cx, cy, cx, cy+dy*bh, fill=self.ACCENT, width=2)

        # horizontal dividers
        cy = H // 2
        self.canvas.create_line(0, cy - 180, W, cy - 180, fill=self.DIM, width=1)
        self.canvas.create_line(0, cy + 160, W, cy + 160, fill=self.DIM, width=1)

        # ── avatar circle (glow ring + image) ───────────────────────
        self.avatar_x = W // 2
        self.avatar_y = cy - 260
        r = 110
        # outer glow rings (animated later)
        self.glow1 = self.canvas.create_oval(
            self.avatar_x-r-20, self.avatar_y-r-20,
            self.avatar_x+r+20, self.avatar_y+r+20,
            outline=self.ACCENT2, width=2)
        self.glow2 = self.canvas.create_oval(
            self.avatar_x-r-10, self.avatar_y-r-10,
            self.avatar_x+r+10, self.avatar_y+r+10,
            outline=self.ACCENT, width=2)
        self.glow3 = self.canvas.create_oval(
            self.avatar_x-r, self.avatar_y-r,
            self.avatar_x+r, self.avatar_y+r,
            outline=self.ACCENT, width=3)

        # load and show the avatar image
        self._photo = None
        try:
            img = Image.open("K0sh2.png").resize((r*2, r*2), Image.LANCZOS)
            # circular mask
            mask = Image.new("L", (r*2, r*2), 0)
            import math
            pixels = mask.load()
            for px in range(r*2):
                for py in range(r*2):
                    if math.hypot(px-r, py-r) <= r-2:
                        pixels[px, py] = 255
            img.putalpha(mask)
            self._photo = ImageTk.PhotoImage(img)
        except Exception:
            pass

        if self._photo:
            self.canvas.create_image(self.avatar_x, self.avatar_y,
                                     image=self._photo, anchor=tk.CENTER)
        else:
            # fallback: just draw a circle with text
            self.canvas.create_oval(
                self.avatar_x-r, self.avatar_y-r,
                self.avatar_x+r, self.avatar_y+r,
                fill="#0A0F1E", outline=self.ACCENT, width=3)
            self.canvas.create_text(self.avatar_x, self.avatar_y,
                                    text="K0sh", font=("Consolas", 28, "bold"),
                                    fill=self.ACCENT)

        # ── title block ─────────────────────────────────────────────
        ty = cy - 120
        self.canvas.create_text(W//2, ty,
                                text="K0sh AI",
                                font=("Consolas", 52, "bold"),
                                fill=self.ACCENT)
        self.canvas.create_text(W//2, ty + 58,
                                text="TERMINAL  v0.6.1",
                                font=("Consolas", 16),
                                fill=self.MUTED)

        # animated subtitle (cycles through taglines)
        self.taglines = [
            "SEMANTIC INTELLIGENCE  •  MULTI-GAME ENGINE",
            "GTN  •  ROCK-PAPER-SCISSORS  •  BLACKJACK",
            "MULTILINGUAL  •  PERSISTENT PROFILES  •  ACHIEVEMENTS",
        ]
        self._tag_idx = 0
        self.tag_lbl = self.canvas.create_text(W//2, ty + 86,
                                               text=self.taglines[0],
                                               font=("Consolas", 11),
                                               fill=self.ACCENT2)

        # ── boot text area ──────────────────────────────────────────
        self.boot_y_start = cy + 0
        self.boot_items   = []   # canvas text ids

        # ── loading bar ─────────────────────────────────────────────
        bar_y  = cy + 210
        bar_w  = min(700, W - 120)
        bar_x0 = W//2 - bar_w//2
        bar_x1 = W//2 + bar_w//2
        self.canvas.create_rectangle(bar_x0-2, bar_y-2, bar_x1+2, bar_y+18,
                                     outline=self.DIM, fill="")
        self.canvas.create_rectangle(bar_x0, bar_y, bar_x0, bar_y+14,
                                     fill=self.DIM, outline="")
        self._bar_bg = self.canvas.create_rectangle(
            bar_x0, bar_y, bar_x0, bar_y+14,
            fill=self.DIM, outline="")
        self._bar_fg = self.canvas.create_rectangle(
            bar_x0, bar_y, bar_x0, bar_y+14,
            fill=self.ACCENT, outline="")
        self._bar_x0 = bar_x0
        self._bar_x1 = bar_x1
        self._bar_y0 = bar_y
        self._bar_y1 = bar_y + 14

        self._pct_lbl = self.canvas.create_text(
            W//2, bar_y + 28, text="0%",
            font=("Consolas", 10), fill=self.MUTED)

        # ── status strip at very bottom ──────────────────────────────
        self.canvas.create_text(40, H-18, text="AI CORE: MiniLM-L12-v2",
                                font=("Consolas", 9), fill=self.MUTED, anchor="w")
        self.canvas.create_text(W-40, H-18, text="STATUS: BOOTING…",
                                font=("Consolas", 9), fill=self.GREEN, anchor="e")
        self.canvas.create_text(W//2, H-18, text="© K0sh AI  —  @AlexKotsovolis",
                                font=("Consolas", 9), fill=self.MUTED)

        # ── kick off animations ──────────────────────────────────────
        self._animate_glow()
        self._animate_tagline()
        self._animate_boot_text()
        self._animate_bar()

    # ── animation loops ─────────────────────────────────────────────

    def _animate_glow(self):
        if not self._running:
            return
        self._pulse = (self._pulse + 1) % 40
        t     = self._pulse / 40
        alpha = int(80 + 60 * abs(t - 0.5) * 2)   # 80 → 140 → 80
        col   = f"#{alpha:02x}{min(alpha+40,255):02x}ff"
        # cycle ring colours for a breathing effect
        colors = [
            ("#0044aa", "#0088dd", "#00C8FF"),
            ("#0055cc", "#00aaff", "#66ddff"),
            ("#003388", "#0066cc", "#00C8FF"),
        ]
        idx = self._pulse // 14 % 3
        self.canvas.itemconfig(self.glow1, outline=colors[idx][0])
        self.canvas.itemconfig(self.glow2, outline=colors[idx][1])
        self.canvas.itemconfig(self.glow3, outline=colors[idx][2])
        self._after_ids.append(self.root.after(50, self._animate_glow))

    def _animate_tagline(self):
        if not self._running:
            return
        self._tag_idx = (self._tag_idx + 1) % len(self.taglines)
        self.canvas.itemconfig(self.tag_lbl, text=self.taglines[self._tag_idx])
        self._after_ids.append(self.root.after(2000, self._animate_tagline))

    def _animate_boot_text(self):
        if not self._running:
            return
        if self._line_idx < len(self.BOOT_LINES):
            text, color = self.BOOT_LINES[self._line_idx]
            if color:
                y = self.boot_y_start + self._line_idx * 22
                tid = self.canvas.create_text(
                    self.W // 2, y,
                    text=text, font=("Consolas", 11),
                    fill=color, anchor=tk.CENTER)
                self.boot_items.append(tid)
            self._line_idx += 1
            delay = 600 if self._line_idx < len(self.BOOT_LINES) - 1 else 800
            self._after_ids.append(self.root.after(delay, self._animate_boot_text))

    def _animate_bar(self):
        if not self._running:
            return
        target = min(self._line_idx / max(len(self.BOOT_LINES), 1), 1.0)
        # ease toward target
        self._bar_pct += (target - self._bar_pct) * 0.15
        pct = self._bar_pct
        x1  = self._bar_x0 + int((self._bar_x1 - self._bar_x0) * pct)
        self.canvas.coords(self._bar_fg,
                           self._bar_x0, self._bar_y0,
                           x1, self._bar_y1)
        self.canvas.itemconfig(self._pct_lbl, text=f"{int(pct*100)}%")
        if pct >= 0.98:
            self.canvas.itemconfig(self._pct_lbl, text="100%  —  READY")
            self.root.after(700, self._finish)
        else:
            self.root.after(30, self._animate_bar)

    def _finish(self):
        if not self._running:
            return
        self._running = False
        for aid in self._after_ids:
            try:
                self.root.after_cancel(aid)
            except Exception:
                pass
        self.root.destroy()
        self.on_done()

    def run(self):
        self.root.mainloop()


def launch_main():
    root = tk.Tk()
