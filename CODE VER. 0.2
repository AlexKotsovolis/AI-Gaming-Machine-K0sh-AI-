lower_list = ["Higher!", "Nope, this is lower than the number!"]
higher_list = ["Lower!", "Please try going lower!"]
win_list = ["Great job! You found it!", "This was really fun!", "Whoa! How did you win?!"]

question_texts = [q for q, a in qa_pairs]
question_embeddings = model.encode(question_texts, convert_to_tensor=True)

THRESHOLD = 0.3


def get_response(user_input):
    input_embedding = model.encode(user_input, convert_to_tensor=True)
    similarities = util.cos_sim(input_embedding, question_embeddings)[0]
    best_idx = similarities.argmax().item()
    best_score = similarities[best_idx].item()

    if best_score < THRESHOLD:
        return best_score, "Sorry, I don't understand. Try asking about: What is this game? ,or simply say: What is your name? "

    return best_score, qa_pairs[best_idx][1]


class K0sh:
    def __init__(self, root):
        self.root = root
        self.root.title("🤖 K0sh AI // System Terminal")

        self.root.attributes("-fullscreen", True)
        self.root.configure(bg="#0F0F12")


        self.root.bind("<Escape>", lambda event: self.root.attributes("-fullscreen", False))

        # STATE
        self.is_playing = False
        self.is_inchat = True

        # OTHER VARIABLES
        self.num = 0
        self.guesses = 0
        self.attempts = 0

        # Top decorative spacing container for fullscreen placement
        top_spacer = tk.Frame(root, bg="#0F0F12", height=40)
        top_spacer.pack(side=tk.TOP, fill=tk.X)

        tk.Label(
            root, text="🎮 K0sh AI: GUESS THE NUMBER 🎮", font=("Impact", 36),
            fg="#00FF66", bg="#0F0F12"
        ).pack(pady=20)

        # Expanded component sizing for large display structures
        self.chat_area = scrolledtext.ScrolledText(
            root, wrap=tk.WORD, height=28, width=110, font=("Consolas", 14),
            bg="#1A1A24", fg="#00FF66", insertbackground="#00FF66",
            highlightbackground="#333344", highlightcolor="#00FF66", highlightthickness=2
        )
        self.chat_area.pack(pady=20, padx=40)
        self.chat_area.insert(tk.END, "Loading K0sh...\n")
        self.chat_area.insert(tk.END, "Loaded K0sh successfully!\n")
        self.chat_area.insert(tk.END, f"\nBot: Hi! My name is K0sh! ")
        self.chat_area.insert(tk.END, f"\nBot: Today, we are going to play a game of... Guess the number! ")
        self.chat_area.insert(tk.END, f"\nBot: Feel free to ask anything you want, before we start! ")
        self.chat_area.insert(tk.END, f"\nBot: In order to start the game, send the word: INT. \n")
        self.chat_area.insert(tk.END, f"\n[SYSTEM NOTICE: Press 'ESC' key to leave fullscreen mode]\n")
        self.chat_area.config(state="disabled")

        input_frame = tk.Frame(root, bg="#0F0F12")
        input_frame.pack(pady=20)

        self.input_field = tk.Entry(
            input_frame, width=70, font=('Consolas', 16), bg="#222233", fg="#FFFFFF",
            insertbackground="#FFFFFF", highlightbackground="#333344", highlightcolor="#00FF66", highlightthickness=2
        )
        self.input_field.pack(side=tk.LEFT, pady=10, padx=15)
        self.input_field.bind("<Return>", lambda event: self.send_message())

        tk.Button(
            input_frame, text="SEND CMD", command=self.send_message, font=("Impact", 16),
            bg="#00FF66", fg="#0F0F12", activebackground="#00CC52", activeforeground="#0F0F12",
            width=12, relief=tk.FLAT
        ).pack(side=tk.RIGHT, padx=5)

        # Control panel layout at base
        control_frame = tk.Frame(root, bg="#0F0F12")
        control_frame.pack(pady=20)

        tk.Button(
            control_frame, text="RESET TERMINAL", command=self.clear_chat, font=("Impact", 14),
