        ).pack(side=tk.RIGHT, padx=15)

    def clear_chat(self):
        self.chat_area.config(state='normal')
        self.chat_area.delete(1.0, tk.END)
        self.chat_area.insert(tk.END, f"\nBot: Hi! My name is K0sh! ")
        self.chat_area.insert(tk.END, f"\nBot: Today, we are going to play a game of... Guess the number! ")
        self.chat_area.insert(tk.END, f"\nBot: Feel free to ask anything you want, before we start! ")
        self.chat_area.insert(tk.END,
                              f"\nBot: Right now, we are in chat mode. In order to start the game, send the word: INT. \n")
        self.chat_area.config(state='disabled')

    def send_message(self):
        plr_txt = self.input_field.get().strip()
        if not plr_txt:
            return

        self.chat_area.config(state='normal')
        self.chat_area.insert(tk.END, f"\nYou: {plr_txt}\n")

        self.process_input(plr_txt)

        self.chat_area.config(state='disabled')
        self.chat_area.see(tk.END)
        self.input_field.delete(0, tk.END)

    def process_input(self, plr_txt):
        if self.is_playing:
            self.game_handler(plr_txt)
        else:
            # Chat State
            score, response = get_response(plr_txt)
            self.chat_area.insert(tk.END, f"Match confidence: {score:.2f}\n")
            self.chat_area.insert(tk.END, f"Bot: {response}\n")

            # Game mode
            if plr_txt.upper() == "INT":
                self.num = random.randint(0, 100)
                self.guesses = 0
                self.chat_area.insert(tk.END,
                                      f"\nBot: Nice! Let's start. So, I've picked a number from 0-100. Try and guess it!\n")
                self.is_inchat = False
                self.is_playing = True
                return

    def game_handler(self, plr_txt):

        try:
            guess = int(plr_txt)

        except ValueError:
            self.chat_area.insert(tk.END, f"Bot: That is not a number! Please enter a number between 0 and 100.\n")
            return

        self.guesses += 1

        # Check bounds first
        if guess < 0 or guess > 100:
            self.chat_area.insert(tk.END, f"Bot: No! The number is between 0 and 100! (THIS COUNTS AS A GUESS)\n")
        elif guess == self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(win_list)}\n")
            self.chat_area.insert(tk.END, f"Bot: Your guesses: {self.guesses}!\n")
            self.chat_area.insert(tk.END, f"Bot: Send the word: INT if you wish to play again!\n")
            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(lower_list)}\n")
        elif guess >= self.num:
            self.chat_area.insert(tk.END, f"Bot: {random.choice(higher_list)}\n")


