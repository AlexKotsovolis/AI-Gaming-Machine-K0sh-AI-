                f"\nBot: Well {self.name}... This is a number.. please guess between Rock, Paper, or Scissors?\n")
            return

        self.guesses += 1
        msg = ""

        if (
                (guess2 == "rock" and self.choice == "Rock") or
                (guess2 == "paper" and self.choice == "Paper") or
                (guess2 == "scissors" and self.choice == "Scissors")
        ):
