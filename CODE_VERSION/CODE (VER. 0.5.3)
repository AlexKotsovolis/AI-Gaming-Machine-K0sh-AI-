            f"\nBot: Today, we are going to play a game of your choice! "
            f"\nBot: Feel free to ask anything you want, before we start! "
            f"\nBot: Right now, we are in chat mode. In order to start a game, send the word: GTN, RPS, or BLC.\n"
            f"\n[SYSTEM NOTICE: Press 'ESC' key to leave fullscreen mode]\n"
        )
        self.chat_area.config(state='disabled')
        self.safe_append_chat(msg)

    def send_message(self):
        plr_txt = self.input_field.get().strip()
        if not plr_txt:
            return

        self.input_field.delete(0, tk.END)
        self.send.config(state=tk.DISABLED)
        self.input_field.config(state=tk.DISABLED)

        self.chat_area.config(state='normal')
        self.chat_area.insert(tk.END, f"\nYou: {plr_txt}\n")
        self.chat_area.config(state='disabled')
        self.chat_area.see(tk.END)

        thread = threading.Thread(target=self.process_input, args=(plr_txt,), daemon=True)
        thread.start()

    def process_input(self, plr_txt):
        if self.name == "Empty":
            success, bot_message = self.check_for_user(plr_txt)
            self.safe_append_chat(f"Bot: {bot_message}\n")
            self.root.after(0, self.update_sidebar_profile)
            return

        if self.is_playing:
            self.game_handler(plr_txt)
        elif self.is_playing2:
            self.game_handler2(plr_txt)
        elif self.is_playing3:
            self.game_handler3(plr_txt)
        else:
            # Game Initialization System Routing
            if plr_txt.upper() == "GTN":
                self.num = random.randint(0, 100)
                self.guesses = 0
                self.safe_append_chat(
                    f"\nBot: Nice, {self.name}! Let's start. So, I've picked a number from 0-100. Try and guess it!\n")
                self.is_inchat = False
                self.is_playing = True
                return

            if plr_txt.upper() == "RPS":
                self.choice = random.choice(choice_list)
                self.guesses = 0
                self.safe_append_chat(
                    f'\nBot: Alrighty {self.name}! I pick one from: Rock, Paper or Scissors. \nBot: Remember {self.name}! Rock beats Scissors, Paper beats Rock and Scissors beats Paper. \nBot: Enter your move to begin!\n')
                self.is_inchat = False
                self.is_playing2 = True
                return

            if plr_txt.upper() == "BLC":
                self.is_playing3 = True
                self.Black_jack_Score = 0
                self.Black_jack_bot_Score = 0

                player_roll = random.randint(1, 6)
                bot_roll = random.randint(1, 6)
                self.Black_jack_Score += player_roll
                self.Black_jack_bot_Score += bot_roll

                self.safe_append_chat(
                    f"\nBot: Nice choice for a game {self.name}! Each round we will roll a 1-6 dice. Get as close to 21 as possible without exceeding it.\n"
                    f"Bot: 🎲 Initial Deal! You rolled a {player_roll} (Total: {self.Black_jack_Score}).\n"
                    f"Bot: 🎲 I rolled an initial {bot_roll}.\n"
                    f"Bot: Please type **hit** to roll again, or **stand** to freeze your hand!\n"
                )
                self.is_inchat = False
                return

            # Semantic AI Conversation Matching
            score, response = get_response(plr_txt)
            self.safe_append_chat(f"[System Match Metric Conf: {score * 100:.1f}%]\nBot: {response}\n")

    def game_handler(self, plr_txt):
        try:
            guess = int(plr_txt)
        except ValueError:
            self.safe_append_chat(f"Bot: That is not a number! Please enter a number between 0 and 100.\n")
            return

        self.guesses += 1
        userdata[self.name]['InGameScore'] -= 1
        self.root.after(0, self.update_sidebar_profile)

        msg = f"Bot: Your account points: {userdata[self.name]['InGameScore']} (1 point was taken from you, {self.name}.)\n"

        if guess < 0 or guess > 100:
            msg += f"Bot: Come on {self.name}, you know this is not an eligible number! The number is between 0 and 100!\n"
        elif guess == self.num:
            msg += f"Bot: {random.choice(win_list)}\n"
            userdata[self.name]["InGameScore"] += 10
            msg += f"Bot: Your guesses: {self.guesses}, Your Points: {userdata[self.name]['InGameScore']}\n"
            msg += f"Bot: Reply with **RPS**, **GTN**, or **BLC** if you wish to swap modes!\n"
            self.is_inchat = True
            self.is_playing = False
        elif guess <= self.num:
            msg += f"Bot: {random.choice(higher_list)}\n"
        elif guess >= self.num:
            msg += f"Bot: {random.choice(lower_list)}\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

    def game_handler2(self, plr_txt):
        guess2 = plr_txt.strip().lower()
        self.choice = random.choice(choice_list)

        if guess2.isdigit():
            self.safe_append_chat(
                f"\nBot: Well {self.name}... This is a number.. please guess between Rock, Paper, or Scissors?\n")
            return

        self.guesses += 1
        msg = ""

        if (
                (guess2 == "rock" and self.choice == "Rock") or
                (guess2 == "paper" and self.choice == "Paper") or
                (guess2 == "scissors" and self.choice == "Scissors")
        ):
            msg += f"Bot: That is a draw {self.name}! Keep throwing or switch modes via command acronyms.\n"
        elif guess2 == 'rock' and self.choice == 'Paper':
            msg += f"Bot: I choose Paper!\nBot: {random.choice(lose_list)}\n"
            userdata[self.name]["InGameScore"] -= 20
            self.is_inchat = True
            self.is_playing2 = False
        elif guess2 == 'rock' and self.choice == 'Scissors':
            msg += f"Bot: I choose Scissors!\nBot: {random.choice(win_list)}\n"
            userdata[self.name]["InGameScore"] += 20
            self.is_inchat = True
            self.is_playing2 = False
        elif guess2 == 'paper' and self.choice == 'Rock':
            msg += f"Bot: I choose Rock!\nBot: {random.choice(win_list)}\n"
            userdata[self.name]["InGameScore"] += 20
            self.is_inchat = True
            self.is_playing2 = False
        elif guess2 == 'paper' and self.choice == 'Scissors':
            msg += f"Bot: I choose Scissors!\nBot: {random.choice(lose_list)}\n"
            userdata[self.name]["InGameScore"] -= 20
            self.is_inchat = True
            self.is_playing2 = False
        elif guess2 == 'scissors' and self.choice == "Rock":
            msg += f"Bot: I choose Rock!\nBot: {random.choice(lose_list)}\n"
            userdata[self.name]["InGameScore"] -= 20
            self.is_inchat = True
            self.is_playing2 = False
        elif guess2 == 'scissors' and self.choice == 'Paper':
            msg += f"Bot: I choose Paper!\nBot: {random.choice(win_list)}\n"
            userdata[self.name]["InGameScore"] += 20
            self.is_inchat = True
            self.is_playing2 = False

        if not self.is_playing2:
            msg += f"Bot: Score balance: {userdata[self.name]['InGameScore']}\n"
            msg += f"Bot: Reply with **GTN**, **RPS**, or **BLC** to launch your next round setup!\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

    def game_handler3(self, plr_txt):
        guess3 = plr_txt.strip().lower()

        if guess3 == "hit":
            self.player_hit()
            msg = f"\nBot: You hit and rolled a {self.inter}! Total points: {self.Black_jack_Score}.\n"

            if self.Black_jack_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            if self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"Bot: I hit as well! I rolled a {self.inter} (Total: {self.Black_jack_bot_Score}).\n"
            else:
                msg += f"Bot: I chose to stand with my current points.\n"

            if self.Black_jack_bot_Score > self.perfect:
                self.evaluate_results(prefix_msg=msg)
                return

            self.safe_append_chat(msg)
            return

        elif guess3 == "stand":
            msg = f"\nBot: You decided to stay with a score of: {self.Black_jack_Score}\n"

            while self.Black_jack_bot_Score < 16:
                self.bot_hit()
                msg += f"Bot: I hit to catch up! I rolled a {self.inter} (Total: {self.Black_jack_bot_Score}).\n"

            self.evaluate_results(prefix_msg=msg)
            return
        else:
            self.safe_append_chat(f"\nBot: Invalid move! Please type 'hit' or 'stand' to continue playing.\n")
            return

    def evaluate_results(self, prefix_msg=""):
        msg = prefix_msg + f"\nBot: Let's check our final scores! My score: --{self.Black_jack_bot_Score}-- vs Your score: --{self.Black_jack_Score}--.\n"

        if self.Black_jack_Score > self.perfect:
            msg += f"Bot: You exceeded 21 and busted! You lost 50 points. 💀\n"
            userdata[self.name]["InGameScore"] -= 50
        elif self.Black_jack_bot_Score > self.perfect:
            msg += f"Bot: I exceeded 21 and busted! You won 50 points! 🎉\n"
            userdata[self.name]["InGameScore"] += 50
        elif self.Black_jack_Score > self.Black_jack_bot_Score:
            msg += f"Bot: {random.choice(win_list)} (+50 points)\n"
            userdata[self.name]["InGameScore"] += 50
        elif self.Black_jack_bot_Score > self.Black_jack_Score:
            msg += f"Bot: {random.choice(lose_list)} (-50 points)\n"
            userdata[self.name]["InGameScore"] -= 50
        else:
            msg += f"Bot: It's a draw match! No points altered.\n"

        msg += f"Bot: Your Total Points: {userdata[self.name]['InGameScore']}\n"
        msg += f"Bot: Type 'BLC' to play again, or choose 'GTN' / 'RPS'!\n"

        self.safe_append_chat(msg)
        self.root.after(0, self.update_sidebar_profile)

        self.Black_jack_Score = 0
        self.Black_jack_bot_Score = 0
        self.is_playing3 = False
        self.is_inchat = True

    def destroy(self):
        with open("userdata.json", "w") as file:
            json.dump(userdata, file, indent=4)
        self.root.destroy()

    def check_for_user(self, name):
        if name in userdata:
            self.name = name
            return True, f"Welcome back {self.name}! Dynamic system node re-established. 💾"
        elif name.isalpha():
            self.name = name
            userdata[self.name] = {"Joined": True, "InGameScore": 0}
            with open("userdata.json", "w") as file:
                json.dump(userdata, file, indent=4)
            return True, f"Welcome {self.name}, I am K0sh! New dynamic profile created. 💾"
        else:
            return False, "This isn't an alphabetical name string. Please try again!"

    def safe_append_chat(self, message):
        self.skipped_anim = False
        self.current_message = message
        self.send.config(state=tk.DISABLED)

        self.skip_btn.config(state=tk.NORMAL)
        self.root.after(0, self._typewriter_stream, message, 0)

    def _typewriter_stream(self, message, index):
        self.current_index = index

        if self.skipped_anim:
            return

        if index < len(message):
            self.chat_area.config(state='normal')
            self.chat_area.insert(tk.END, message[index])
            self.chat_area.config(state='disabled')
            self.chat_area.see(tk.END)
            self.root.after(10, lambda: self._typewriter_stream(message, index + 1))
        else:
            self.skip_btn.config(state=tk.DISABLED)
            self.send.config(state=tk.NORMAL)
            self.input_field.config(state=tk.NORMAL)
            self.input_field.focus()

    def _typewriter_skip(self):
        self.skipped_anim = True
        self.skip_btn.config(state=tk.DISABLED)

        remaining_text = self.current_message[self.current_index:]
        self.chat_area.config(state='normal')
        if remaining_text:
            self.chat_area.insert(tk.END, remaining_text)
        self.chat_area.config(state='disabled')
        self.chat_area.see(tk.END)
        self.skip_btn.config(state=tk.DISABLED)
        self.send.config(state=tk.NORMAL)
        self.input_field.config(state=tk.NORMAL)
        self.input_field.focus()

    def player_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_Score += self.inter

    def bot_hit(self):
        self.inter = random.randint(1, 6)
        self.Black_jack_bot_Score += self.inter





