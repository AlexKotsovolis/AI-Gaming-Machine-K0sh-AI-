def get_response(user_input):
    input_embedding = model.encode(user_input, convert_to_tensor=True)

    best_score = -1.0
    best_idx = 0

    # Loop through each category to find which one contains the closest phrase
    for idx, pair in enumerate(qa_pairs):
        similarities = util.cos_sim(input_embedding, pair["question_embeddings"])[0]
        max_idx = similarities.argmax().item()
        max_score = similarities[max_idx].item()

        # Track the absolute best matching group index across the dataset
        if max_score > best_score:
            best_score = max_score
            best_idx = idx

    try:
        lang = detect(user_input)
    except Exception:
        lang = "en"

    if best_score < THRESHOLD:
        fallbacks = {
            "en": "Sorry, I don't understand. Try asking: 'What is this game?'",
            "el": "Συγγνώμη, δεν κατάλαβα. Δοκίμασε να ρωτήσεις: 'Τι παιχνίδι είναι αυτό;'",
            "es": "Lo siento, no entiendo. Intenta preguntar: '¿Qué es este juego?'",
            "fr": "Désolé, je ne comprends pas. Essaie de demander : 'Qu'est-ce que ce jeu ?'",
            "de": "Entschuldigung, das verstehe ich nicht. Frag mal: 'Was ist das für ein Spiel?'",
            "it": "Scusa, non capisco. Prova a chiedere: 'Cos'è questo gioco?'"
        }
        return best_score, fallbacks.get(lang, fallbacks["en"])

    response_dict = qa_pairs[best_idx]["responses"]
    return best_score, response_dict.get(lang, response_dict["en"])

